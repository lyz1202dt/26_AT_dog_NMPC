centroidalModelType             0      // 0: FullCentroidalDynamics, 1: Single Rigid Body Dynamics

legged_robot_interface
{
  verbose                               false  // show the loaded parameters
}

model_settings
{
  positionErrorGain             0.0
  phaseTransitionStanceTime     0.1

  verboseCppAd                  true
  recompileLibrariesCppAd       false
  modelFolderCppAd              ocs2_cpp_ad/at_dog
}

swing_trajectory_config
{
  liftOffVelocity               0.05
  touchDownVelocity            -0.1
  swingHeight                   0.08
  swingTimeScale                0.15
}

; Multiple_Shooting SQP settings
sqp
{
  nThreads                              3
  dt                                    0.015
  sqpIteration                          1
  deltaTol                              1e-4
  g_max                                 1e-2
  g_min                                 1e-6
  inequalityConstraintMu                0.1
  inequalityConstraintDelta             5.0
  projectStateInputEqualityConstraints  true
  printSolverStatistics                 true
  printSolverStatus                     false
  printLinesearch                       false
  useFeedbackPolicy                     false
  integratorType                        RK2
  threadPriority                        60
}

; Rollout settings
rollout
{
  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  timeStep                        0.015
  integratorType                  ODE45
  maxNumStepsPerSecond            10000
  checkNumericalStability         false
}

mpc
{
  timeHorizon                     1.0  ; [s]
  solutionTimeWindow              -1   ; maximum [s]
  coldStart                       false

  debugPrint                      false

  mpcDesiredFrequency             100  ; [Hz]
  mrtDesiredFrequency             1000 ; [Hz] Useless
}

initialState
{
   ;; Normalized Centroidal Momentum: [linear, angular] ;;
   (0,0)  0.0     ; vcom_x
   (1,0)  0.0     ; vcom_y
   (2,0)  0.0     ; vcom_z
   (3,0)  0.0     ; L_x / robotMass
   (4,0)  0.0     ; L_y / robotMass
   (5,0)  0.0     ; L_z / robotMass

   ;; Base Pose: [position, orientation] ;;
   (6,0)  0.0     ; p_base_x
   (7,0)  0.0     ; p_base_y
   (8,0)  0.35     ; p_base_z
   (9,0)  0.0     ; theta_base_z
   (10,0) 0.0     ; theta_base_y
   (11,0) 0.0     ; theta_base_x

   ;; Leg Joint Positions: [LF, RF, LB, RB] ;;
   (12,0) -0.0   ; lf_joint1
   (13,0)  0.72   ; lf_joint2
   (14,0) -1.44   ; lf_joint3
   (15,0)  0.0   ; rf_joint1
   (16,0)  0.72   ; rf_joint2
   (17,0) -1.44   ; rf_joint3
   (18,0) -0.0   ; lb_joint1
   (19,0)  0.72   ; lb_joint2
   (20,0) -1.44   ; lb_joint3
   (21,0)  0.0   ; rb_joint1
   (22,0)  0.72   ; rb_joint2
   (23,0) -1.44   ; rb_joint3
}

; standard state weight matrix
Q
{
  scaling 1e+0

  ;; Normalized Centroidal Momentum: [linear, angular] ;;
  (0,0)   15.0     ; vcom_x
  (1,1)   15.0     ; vcom_y
  (2,2)   100.0    ; vcom_z
  (3,3)   10.0     ; L_x / robotMass
  (4,4)   30.0     ; L_y / robotMass
  (5,5)   30.0     ; L_z / robotMass

  ;; Base Pose: [position, orientation] ;;
  (6,6)   1000.0   ; p_base_x
  (7,7)   1000.0   ; p_base_y
  (8,8)   1500.0   ; p_base_z
  (9,9)   100.0    ; theta_base_z
  (10,10) 300.0    ; theta_base_y
  (11,11) 300.0    ; theta_base_x

  ;; Leg Joint Positions: [LF, RF, LB, RB] ;;
  (12,12) 5.0     ; lf_joint1
  (13,13) 5.0     ; lf_joint2
  (14,14) 2.5     ; lf_joint3
  (15,15) 5.0     ; rf_joint1
  (16,16) 5.0     ; rf_joint2
  (17,17) 2.5     ; rf_joint3
  (18,18) 5.0     ; lb_joint1
  (19,19) 5.0     ; lb_joint2
  (20,20) 2.5     ; lb_joint3
  (21,21) 5.0     ; rb_joint1
  (22,22) 5.0     ; rb_joint2
  (23,23) 2.5     ; rb_joint3
}

; control weight matrix
R
{
  scaling 1e-3

  ;; Feet Contact Forces: [LF, RF, LB, RB] ;;
  (0,0)   1.0       ; lf_link4_force
  (1,1)   1.0       ; lf_link4_force
  (2,2)   1.0       ; lf_link4_force
  (3,3)   1.0       ; rf_link4_force
  (4,4)   1.0       ; rf_link4_force
  (5,5)   1.0       ; rf_link4_force
  (6,6)   1.0       ; lb_link4_force
  (7,7)   1.0       ; lb_link4_force
  (8,8)   1.0       ; lb_link4_force
  (9,9)   1.0       ; rb_link4_force
  (10,10) 1.0       ; rb_link4_force
  (11,11) 1.0       ; rb_link4_force

  ;; foot velocity relative to base: [LF, RF, LB, RB] (uses the Jacobian at nominal configuration) ;;
  (12,12) 5000.0    ; x
  (13,13) 5000.0    ; y
  (14,14) 5000.0    ; z
  (15,15) 5000.0    ; x
  (16,16) 5000.0    ; y
  (17,17) 5000.0    ; z
  (18,18) 5000.0    ; x
  (19,19) 5000.0    ; y
  (20,20) 5000.0    ; z
  (21,21) 5000.0    ; x
  (22,22) 5000.0    ; y
  (23,23) 5000.0    ; z
}

frictionConeSoftConstraint
{
  frictionCoefficient    0.3

  ; relaxed log barrier parameters
  mu                     0.1
  delta                  5.0
}

selfCollision
{
  ; Self Collision raw object pairs
  collisionObjectPairs
  {
  }

  ; Self Collision pairs
  collisionLinkPairs
  {
    [0] "lf_link3, rf_link3"
    [1] "lb_link3, rb_link3"
    [2] "lf_link3, lb_link3"
    [3] "rf_link3, rb_link3"
    [4] "lf_link4, rf_link4"
    [5] "lb_link4, rb_link4"
    [6] "lf_link4, lb_link4"
    [7] "rf_link4, rb_link4"
  }

  minimumDistance  0.05

  ; relaxed log barrier parameters
  mu      1e-2
  delta   1e-3
}

; Whole body control
torqueLimitsTask
{
   (0,0)  20.0     ; joint1
   (1,0)  20.0     ; joint2
   (2,0)  20.0     ; joint3
}

frictionConeTask
{
  frictionCoefficient    0.3
}

swingLegTask
{
    kp                   350
    kd                   37
}

weight
{
    swingLeg        100
    baseAccel       1
    contactForce    0.05
}


; State Estimation
kalmanFilter
{
    footRadius                  0.02
    imuProcessNoisePosition     0.02
    imuProcessNoiseVelocity     0.02
    footProcessNoisePosition    0.002
    footSensorNoisePosition     0.005
    footSensorNoiseVelocity     0.1
    footHeightSensorNoise       0.01
}
