<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<ros2_control name="at_dog_sys" type="system">

		<hardware>
			<plugin>hardware_at_dog/HardwareATDog</plugin>
		</hardware>

		<joint name="lf_hip_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="lf_thigh_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="lf_calf_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="rf_hip_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="rf_thigh_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="rf_calf_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="lb_hip_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="lb_thigh_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="lb_calf_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="rb_hip_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="rb_thigh_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<joint name="rb_calf_joint">
			<command_interface name="position"/>
			<command_interface name="velocity"/>
			<command_interface name="effort"/>
			<command_interface name="kp"/>
			<command_interface name="kd"/>

			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<sensor name="imu_sensor">
			<state_interface name="orientation.w"/>
			<state_interface name="orientation.x"/>
			<state_interface name="orientation.y"/>
			<state_interface name="orientation.z"/>
			<state_interface name="angular_velocity.x"/>
			<state_interface name="angular_velocity.y"/>
			<state_interface name="angular_velocity.z"/>
			<state_interface name="linear_acceleration.x"/>
			<state_interface name="linear_acceleration.y"/>
			<state_interface name="linear_acceleration.z"/>
		</sensor>

		<sensor name="foot_force">
			<state_interface name="lf"/>
			<state_interface name="rf"/>
			<state_interface name="lb"/>
			<state_interface name="rb"/>
		</sensor>

		<sensor name="odometer">
			<state_interface name="position.x"/>
			<state_interface name="position.y"/>
			<state_interface name="position.z"/>
			<state_interface name="velocity.x"/>
			<state_interface name="velocity.y"/>
			<state_interface name="velocity.z"/>
		</sensor>

	</ros2_control>

</robot>
