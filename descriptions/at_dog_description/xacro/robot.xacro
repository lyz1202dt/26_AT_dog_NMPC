<?xml version="1.0"?>

<robot name="at_dog" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="SIMULATE" default="true"/>

  <xacro:include filename="$(find at_dog_description)/model/dog.urdf"/>

  <xacro:if value="$(arg SIMULATE)">
    <xacro:include filename="$(find at_dog_description)/xacro/ros2_control_sim.xacro"/>
  </xacro:if>

  <xacro:unless value="$(arg SIMULATE)">
    <xacro:include filename="$(find at_dog_description)/xacro/ros2_control_real.xacro"/>
  </xacro:unless>

