          <joint name="lf_joint3" pos="0 0 0" axis="0 0 1" range="-3 3" actuatorfrcrange="-20 20"/>
          <geom type="mesh" rgba="0.266667 0 0.933333 1" mesh="lf_link3"/>
          <geom pos="0.243132 0.012189 -0.0235007" quat="0 0 0 -1" type="sphere" rgba="0.482353 0.027451 0 1" size="0.02" friction="1.2 0.01 0.0001"/>
        </body>
      </body>
    </body>
    <body name="rf_link1" pos="0.1916 -0.070013 0.061999" quat="0.707105 0 0.707108 0">
      <inertial pos="-0.00109457 -0.00876291 0.044547" quat="0.476235 0.539457 0.520405 0.459745" mass="0.305259" diaginertia="0.000294539 0.000186896 0.000135452"/>
      <joint name="rf_joint1" pos="0 0 0" axis="0 0 1" range="-3 3" actuatorfrcrange="-20 20"/>
      <geom type="mesh" rgba="1 1 1 1" mesh="rf_link1"/>
      <body name="rf_link2" pos="-0.0010387 -0.029268 0.059987" quat="0.707105 0.707108 0 0">
        <inertial pos="0.0658456 0.000279501 0.0526643" quat="0.0208579 0.706816 -0.0207629 0.706785" mass="0.653396" diaginertia="0.00226248 0.00198515 0.000303326"/>
        <joint name="rf_joint2" pos="0 0 0" axis="0 0 1" range="-3 3" actuatorfrcrange="-20 20"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="rf_link2"/>
        <body name="rf_link3" pos="0.22999 1.0169e-05 0.0935" quat="0.707105 0 0 0.707108">
          <inertial pos="0.0467607 -0.00175159 0.0815497" quat="0.676226 -0.193626 -0.19761 0.682773" mass="0.198135" diaginertia="0.00490176 0.00457448 0.000373869"/>
          <joint name="rf_joint3" pos="0 0 0" axis="0 0 1" range="-3 3" actuatorfrcrange="-20 20"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="rf_link3"/>
          <geom pos="0.24313 -0.013026 -0.023046" quat="0.0179954 0.999838 0 0" type="sphere" rgba="0.482353 0.027451 0 1" size="0.02" friction="1.2 0.01 0.0001"/>
        </body>
      </body>
    </body>
    <body name="lb_link1" pos="-0.1916 0.070013 0.061999" quat="-2.59734e-06 0.707105 -2.59735e-06 -0.707108">
      <inertial pos="-0.000761616 -0.00879802 0.044547" quat="0.467448 0.52951 0.530523 0.468677" mass="0.305259" diaginertia="0.000294539 0.000186896 0.000135452"/>
