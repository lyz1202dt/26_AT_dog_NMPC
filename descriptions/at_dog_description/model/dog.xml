      <body name="lf_link2" pos="-0.000957 0.029298 0.060013" quat="0.707105 -0.707108 0 0">
        <inertial pos="0.0668406 -0.00037093 0.0525635" quat="-0.0206424 0.706818 0.0207042 0.706791" mass="0.644661" diaginertia="0.00225868 0.00198331 0.000301352"/>
